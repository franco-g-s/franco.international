---
interface GardenNote {
  title: string
  slug: string
  date: string | null
  description: string | null
}
interface GitHubUser {
  avatar: string
  name: string
  bio: string
  repos: number
}
interface StravaActivity {
  id: number
  name: string
  sport_type: string
  distance: number    // metres
  moving_time: number // seconds
  start_date: string  // ISO 8601
  calories: number
}
interface ElsewhereItem {
  label: string
  handle: string
  desc: string
  href: string
  avatar: string
  stravaData?: string // JSON-encoded StravaActivity[] for lightbox
}

// ── Garden section cards (curated, not recent-notes) ─────────────────────────
// Ordered: the display order in the floating section.
// exercise/ has no feed entry so it always uses the fallback description.
const gardenSections = [
  { slug: "projects/", label: "Projects",  fallback: "Coding, hardware, and research projects." },
  { slug: "about/",    label: "About",     fallback: null },
  { slug: "exercise/", label: "Exercise",  fallback: "Training logs — cycling, running, hiking, rowing." },
  { slug: "media/",    label: "Media",     fallback: "Books, films, videos, and other media." },
  { slug: "notes/",    label: "Notes",     fallback: "General notes and reflections." },
]

let gardenCards: GardenNote[] = gardenSections.map(s => ({
  title: s.label, slug: s.slug, date: null, description: s.fallback,
}))
try {
  const res = await fetch("https://garden.franco.international/notes.json")
  if (res.ok) {
    const all: GardenNote[] = await res.json()
    const bySlug = new Map(all.map(n => [n.slug, n]))
    gardenCards = gardenSections.map(s => bySlug.get(s.slug) ?? {
      title: s.label, slug: s.slug, date: null, description: s.fallback,
    })
  }
} catch { /* garden unavailable at build time */ }

// ── GitHub public data (no auth needed) ───────────────────────────────────────
let github: GitHubUser = { avatar: "https://github.com/franco-g-s.png", name: "franco-g-s", bio: "", repos: 0 }
try {
  const ghRes = await fetch("https://api.github.com/users/franco-g-s", {
    headers: { "User-Agent": "franco-international-hub" },
  })
  if (ghRes.ok) {
    const gh = await ghRes.json()
    github = { avatar: gh.avatar_url, name: gh.name || gh.login, bio: gh.bio || "", repos: gh.public_repos || 0 }
  }
} catch {}

// ── Strava recent activities (build-time, needs secrets in CI) ────────────────
let stravaActivities: StravaActivity[] = []
const stravaClientId     = import.meta.env.STRAVA_CLIENT_ID     as string | undefined
const stravaClientSecret = import.meta.env.STRAVA_CLIENT_SECRET as string | undefined
const stravaRefreshToken = import.meta.env.STRAVA_REFRESH_TOKEN as string | undefined
if (stravaClientId && stravaClientSecret && stravaRefreshToken) {
  try {
    const tokenRes = await fetch("https://www.strava.com/oauth/token", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        client_id:     stravaClientId,
        client_secret: stravaClientSecret,
        refresh_token: stravaRefreshToken,
        grant_type:    "refresh_token",
      }),
    })
    if (tokenRes.ok) {
      const { access_token } = await tokenRes.json()
      const actRes = await fetch(
        "https://www.strava.com/api/v3/athlete/activities?per_page=3",
        { headers: { Authorization: `Bearer ${access_token}` } },
      )
      if (actRes.ok) stravaActivities = await actRes.json()
    }
  } catch { /* Strava unavailable or credentials missing */ }
}

function fmtDate(iso: string | null) {
  if (!iso) return ""
  return new Date(iso).toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" })
}
function truncate(str: string | null, n: number) {
  if (!str) return ""
  return str.length > n ? str.slice(0, n).trimEnd() + "…" : str
}
function fmtDuration(seconds: number) {
  const h = Math.floor(seconds / 3600)
  const m = Math.floor((seconds % 3600) / 60)
  return h > 0 ? `${h}h ${m}m` : `${m}m`
}
function fmtActivityDate(iso: string) {
  return new Date(iso).toLocaleDateString("en-GB", { day: "numeric", month: "short" })
}
function fmtSport(raw: string) {
  return raw.replace(/([a-z])([A-Z])/g, "$1 $2")
}
function fmtActivity(a: StravaActivity) {
  const parts: string[] = [fmtSport(a.sport_type)]
  if (a.distance > 0) parts.push(`${(a.distance / 1000).toFixed(1)} km`)
  parts.push(fmtDuration(a.moving_time))
  if (a.calories > 0) parts.push(`${Math.round(a.calories)} kcal`)
  parts.push(fmtActivityDate(a.start_date))
  return parts.join(" · ")
}

// ── Photos: positioned to avoid zone label overlap ────────────────────────────
// Zone labels sit at 162vh, 292vh, 422vh — all centered (left 50%).
// No photo anchor should vertically overlap those rows near the center.
const photos = [
