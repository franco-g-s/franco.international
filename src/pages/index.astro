  "top:415vh;left:26%",
  "top:428vh;left:57%",
  "top:420vh;left:75%",
  "top:442vh;left:38%",
]

// ── Platform logos (inline SVG, brand colours) ───────────────────────────────
const platformLogos: Record<string, string> = {
