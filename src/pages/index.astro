---
interface GardenNote {
  title: string
  slug: string
  date: string | null
  description: string | null
}

let recentNotes: GardenNote[] = []
try {
  const res = await fetch("https://garden.franco.international/notes.json")
  if (res.ok) {
    const all: GardenNote[] = await res.json()
    recentNotes = all.slice(0, 3)
  }
} catch { /* garden unavailable at build time */ }

function fmtDate(iso: string | null) {
  if (!iso) return ""
  return new Date(iso).toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" })
}

// ── Photos: spread across full 500vh canvas ─────────────────────────────────
const photos = [
  { id: "01", top: "5vh",   left: "4%",  w: 210, h: 158, depth: "0.012" },
  { id: "02", top: "12vh",  left: "24%", w: 152, h: 212, depth: "0.009" },
  { id: "03", top: "3vh",   left: "57%", w: 182, h: 138, depth: "0.015" },
  { id: "04", top: "8vh",   left: "79%", w: 148, h: 202, depth: "0.010" },
  { id: "05", top: "80vh",  left: "2%",  w: 172, h: 132, depth: "0.008" },
  { id: "06", top: "90vh",  left: "80%", w: 142, h: 192, depth: "0.013" },
  { id: "07", top: "210vh", left: "6%",  w: 158, h: 122, depth: "0.011" },
  { id: "08", top: "232vh", left: "79%", w: 175, h: 135, depth: "0.007" },
  { id: "09", top: "330vh", left: "3%",  w: 182, h: 142, depth: "0.014" },
  { id: "10", top: "352vh", left: "77%", w: 158, h: 118, depth: "0.009" },
  { id: "11", top: "462vh", left: "8%",  w: 142, h: 192, depth: "0.012" },
  { id: "12", top: "478vh", left: "74%", w: 168, h: 128, depth: "0.010" },
]

// ── Card positions (relative to their zone centers) ──────────────────────────
// Garden zone at 165vh, CV zone at 290vh, Elsewhere zone at 415vh
const notePos  = ["top:138vh;left:7%",  "top:160vh;left:62%", "top:182vh;left:22%"]
const cvPos    = ["top:268vh;left:6%",  "top:280vh;left:64%", "top:300vh;left:18%", "top:292vh;left:73%"]
const socialPos = ["top:394vh;left:8%", "top:407vh;left:27%", "top:420vh;left:56%", "top:412vh;left:74%", "top:432vh;left:41%"]

const cvHighlights = [
  { label: "Based in",   value: "Zürich, Switzerland" },
  { label: "Upcoming",   value: "ETH Zürich — Mechanical Engineering (2027)" },
  { label: "Currently",  value: "Autonomous Systems Lab, ETH Zürich — Zivildienst" },
  { label: "Languages",  value: "English, Spanish, German, French, Italian, Mandarin" },
]

const elsewhere = [
  { label: "Instagram", href: "https://www.instagram.com/franco_gomez_s/" },
  { label: "Strava",    href: "https://www.strava.com/athletes/franco" },
  { label: "YouTube",   href: "https://www.youtube.com/@franco" },
  { label: "LinkedIn",  href: "https://www.linkedin.com/in/franco-gómez-schumacher-17a985123/" },
  { label: "GitHub",    href: "https://github.com/franco-g-s" },
]
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Franco Gómez Schumacher" />
  <title>Franco Gómez Schumacher</title>
  <link rel="preconnect" href="https://rsms.me/" />
  <link rel="stylesheet" href="https://rsms.me/inter/inter.css" />
</head>

<body>
<div class="canvas">

  <!-- ── Anchored headings (no animation) ────────────────────────── -->
  <h1 class="anchor name">
    <span>Franco Gómez</span>
    <span>Schumacher</span>
  </h1>
  <p class="anchor zone-label" style="top:165vh;left:50%">Garden</p>
  <p class="anchor zone-label" style="top:290vh;left:50%">CV</p>
  <p class="anchor zone-label" style="top:415vh;left:50%">Elsewhere</p>

  <!-- ── Photos ──────────────────────────────────────────────────── -->
  {photos.map((p) => (
    <div
      class="float"
      data-type="photo"
      data-src={`/photos/${p.id}.jpg`}
      data-depth={p.depth}
      style={`top:${p.top};left:${p.left};width:${p.w}px;height:${p.h}px`}
    >
      <div class="float-inner">
        <img src={`/photos/${p.id}.jpg`} alt="" width={p.w} height={p.h}
             loading="eager" draggable="false" />
      </div>
    </div>
  ))}

  <!-- ── Garden note cards ───────────────────────────────────────── -->
  {recentNotes.map((note, i) => (
    <div
      class="float card"
      data-type="note"
      data-title={note.title}
      data-sub={fmtDate(note.date)}
      data-href={`https://garden.franco.international/${note.slug}`}
      data-cta="Read note"
      data-depth="0.007"
      style={notePos[i]}
    >
      <div class="float-inner">
        <p class="card-eye">Note</p>
        <p class="card-title">{note.title}</p>
        {note.date && <p class="card-sub">{fmtDate(note.date)}</p>}
      </div>
    </div>
  ))}

  <!-- Fallback if garden feed unavailable -->
  {recentNotes.length === 0 && (
    <div class="float card" data-type="link" data-href="https://garden.franco.international"
         data-cta="Visit" data-depth="0.007" style={notePos[0]}>
      <div class="float-inner">
        <p class="card-eye">Garden</p>
        <p class="card-title">A growing collection of notes</p>
      </div>
    </div>
  )}

  <!-- ── CV highlight cards ──────────────────────────────────────── -->
  {cvHighlights.map((h, i) => (
    <div
      class="float card"
      data-type="cv"
      data-title={h.label}
      data-sub={h.value}
      data-href="https://cv.franco.international"
      data-cta="View CV"
      data-depth="0.006"
      style={cvPos[i]}
    >
      <div class="float-inner">
        <p class="card-eye">{h.label}</p>
        <p class="card-value">{h.value}</p>
      </div>
    </div>
  ))}

  <!-- ── Social cards ────────────────────────────────────────────── -->
  {elsewhere.map((e, i) => (
    <div
      class="float card card--social"
      data-type="social"
      data-title={e.label}
      data-href={e.href}
      data-cta={`Open ${e.label}`}
      data-depth="0.008"
      style={socialPos[i]}
    >
      <div class="float-inner">
        <p class="card-social">{e.label} ↗</p>
      </div>
    </div>
  ))}

</div>

<!-- ── Lightbox ───────────────────────────────────────────────────── -->
<div id="lightbox" class="lightbox" aria-hidden="true">
  <div class="lb-backdrop"></div>
  <div class="lb-body">
    <div id="lb-content"></div>
    <div id="lb-actions"></div>
  </div>
</div>

</body>
</html>

<style is:global>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
  --text:   #1a1a1a;
  --muted:  #9a9a9a;
  --border: #e4e4e4;
  --bg:     #ffffff;
  --shadow: 0 2px 14px rgba(0,0,0,0.09), 0 1px 3px rgba(0,0,0,0.05);
  --shadow-hover: 0 8px 32px rgba(0,0,0,0.13), 0 2px 6px rgba(0,0,0,0.06);
}

html {
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
  font-feature-settings: "cv05", "ss01";
  background: var(--bg);
  color: var(--text);
  -webkit-font-smoothing: antialiased;
}

body { overflow-x: hidden; }

/* ── Canvas ───────────────────────────────────────────────────────── */
.canvas {
  position: relative;
  min-height: 500vh;
  background: var(--bg);
  overflow: hidden;
}

/* ── Anchors ──────────────────────────────────────────────────────── */
.anchor {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  text-align: center;
  pointer-events: none;
  user-select: none;
  white-space: nowrap;
  z-index: 10;
}

.name {
  top: 50vh;
  transform: translate(-50%, -50%);
  font-size: clamp(2.4rem, 5.5vw, 5rem);
  font-weight: 200;
  letter-spacing: -0.03em;
  line-height: 1.05;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.zone-label {
  transform: translate(-50%, -50%);
  font-size: clamp(1.5rem, 2.5vw, 2.2rem);
  font-weight: 200;
  letter-spacing: -0.025em;
  color: var(--text);
}

/* ── Floats ───────────────────────────────────────────────────────── */
.float {
  position: absolute;
  will-change: transform;
  cursor: pointer;
  z-index: 5;
}

.float-inner {
  width: 100%;
  height: 100%;
  transition: transform 0.28s cubic-bezier(0.34, 1.4, 0.64, 1),
              box-shadow 0.28s ease;
  border-radius: 3px;
}

.float:hover .float-inner { transform: scale(1.04); }

/* Photos */
.float img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  border-radius: 3px;
  box-shadow: var(--shadow);
  pointer-events: none;
  user-select: none;
  background: #ebebeb;
  transition: box-shadow 0.28s ease;
}

.float:hover img { box-shadow: var(--shadow-hover); }

/* Cards */
.card {
  min-width: 160px;
  max-width: 260px;
  width: max-content;
  height: auto !important;
}

.card .float-inner {
  background: var(--bg);
  border: 1px solid var(--border);
  border-radius: 4px;
  padding: 0.85rem 1.1rem;
  box-shadow: var(--shadow);
}

.card:hover .float-inner { box-shadow: var(--shadow-hover); }

.card-eye {
  font-size: 0.65rem;
  font-weight: 500;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--muted);
  margin-bottom: 0.3rem;
}

.card-title {
  font-size: 0.88rem;
  font-weight: 400;
  color: var(--text);
  line-height: 1.4;
  max-width: 22ch;
}

.card-sub {
  font-size: 0.75rem;
  color: var(--muted);
  margin-top: 0.2rem;
}

.card-value {
  font-size: 0.85rem;
  font-weight: 400;
  color: var(--text);
  line-height: 1.45;
  max-width: 24ch;
}

.card-social {
  font-size: 0.9rem;
  font-weight: 400;
  color: var(--text);
}

.card--social { min-width: 120px; max-width: 180px; }

/* ── Lightbox ─────────────────────────────────────────────────────── */
.lightbox {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.22s ease;
}

.lightbox.is-open {
  opacity: 1;
  pointer-events: all;
}

.lb-backdrop {
  position: absolute;
  inset: 0;
  background: rgba(255, 255, 255, 0.80);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
}

.lb-body {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1.5rem;
  max-width: 88vw;
  max-height: 88vh;
}

/* Lightbox: photo */
.lb-photo {
  display: block;
  max-width: 85vw;
  max-height: 80vh;
  object-fit: contain;
  border-radius: 4px;
  box-shadow: 0 16px 60px rgba(0,0,0,0.18), 0 4px 12px rgba(0,0,0,0.10);
}

/* Lightbox: card expand */
.lb-card {
  background: var(--bg);
  border: 1px solid var(--border);
  border-radius: 6px;
  padding: 2rem 2.5rem;
  min-width: 260px;
  max-width: 460px;
  box-shadow: 0 16px 60px rgba(0,0,0,0.12), 0 4px 12px rgba(0,0,0,0.06);
  text-align: center;
}

.lb-eye {
  font-size: 0.68rem;
  font-weight: 500;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--muted);
  margin-bottom: 0.6rem;
}

.lb-title {
  font-size: 1.15rem;
  font-weight: 300;
  letter-spacing: -0.02em;
  line-height: 1.4;
  margin-bottom: 0.4rem;
}

.lb-sub {
  font-size: 0.85rem;
  color: var(--muted);
}

.lb-action {
  display: inline-block;
  font-size: 0.88rem;
  font-weight: 400;
  color: var(--text);
  text-decoration: none;
  border-bottom: 1px solid var(--border);
  padding-bottom: 2px;
  transition: border-color 0.15s;
}

.lb-action:hover { border-color: var(--text); }

/* ── Mobile ───────────────────────────────────────────────────────── */
@media (max-width: 768px) {
  .canvas { min-height: 420vh; }

  .name { font-size: clamp(2rem, 9vw, 3rem); }

  .zone-label { font-size: clamp(1.2rem, 5vw, 1.6rem); }

  /* Reduce photo count visually — hide mid-canvas photos */
  .float[data-photo-id="05"],
  .float[data-photo-id="06"],
  .float[data-photo-id="07"],
  .float[data-photo-id="08"] { display: none; }

  .card { max-width: 180px; }
}
</style>

<script>
  // ── Types ──────────────────────────────────────────────────────────
  interface FloatState {
    el: HTMLElement
    depth: number
    ax1: number; wx1: number; px1: number
    ax2: number; wx2: number; px2: number
    ay1: number; wy1: number; py1: number
    ay2: number; wy2: number; py2: number
    ar: number;  wr: number;  pr: number
  }

  function rand(min: number, max: number) {
    return Math.random() * (max - min) + min
  }

  // ── Mouse tracking ─────────────────────────────────────────────────
  let mouseX = window.innerWidth  / 2
  let mouseY = window.innerHeight / 2
  document.addEventListener("mousemove", (e) => {
    mouseX = e.clientX
    mouseY = e.clientY
  })

  // ── Build float states ─────────────────────────────────────────────
  const states: FloatState[] = []
  document.querySelectorAll<HTMLElement>(".float").forEach((el) => {
    states.push({
      el,
      depth: parseFloat(el.dataset.depth ?? "0.01"),
      ax1: rand(3, 7),    wx1: rand(0.20, 0.42), px1: rand(0, Math.PI * 2),
      ax2: rand(2, 5),    wx2: rand(0.45, 0.72), px2: rand(0, Math.PI * 2),
      ay1: rand(5, 11),   wy1: rand(0.22, 0.48), py1: rand(0, Math.PI * 2),
      ay2: rand(3, 7),    wy2: rand(0.50, 0.80), py2: rand(0, Math.PI * 2),
      ar:  rand(1.2, 2.8), wr: rand(0.18, 0.35), pr: rand(0, Math.PI * 2),
    })
  })

  // ── Animation loop ─────────────────────────────────────────────────
  let startTime: number | null = null
  const cx = () => window.innerWidth  / 2
  const cy = () => window.innerHeight / 2

  function animate(ts: number) {
    if (startTime === null) startTime = ts
    const t = (ts - startTime) / 1000

    for (const s of states) {
      const bobX = s.ax1 * Math.sin(s.wx1 * t + s.px1)
                 + s.ax2 * Math.sin(s.wx2 * t + s.px2)
      const bobY = s.ay1 * Math.sin(s.wy1 * t + s.py1)
                 + s.ay2 * Math.sin(s.wy2 * t + s.py2)
      const rot  = s.ar  * Math.sin(s.wr  * t + s.pr)

      // Very subtle cursor parallax (depth: 0.006–0.015)
      const curX = (mouseX - cx()) * s.depth
      const curY = (mouseY - cy()) * s.depth

      s.el.style.transform =
        `translate(${bobX + curX}px, ${bobY + curY}px) rotate(${rot}deg)`
    }

    requestAnimationFrame(animate)
  }
  requestAnimationFrame(animate)

  // ── Lightbox ───────────────────────────────────────────────────────
  const lightbox   = document.getElementById("lightbox")!
  const lbContent  = document.getElementById("lb-content")!
  const lbActions  = document.getElementById("lb-actions")!
  const lbBackdrop = lightbox.querySelector(".lb-backdrop")!

  function openLightbox(el: HTMLElement) {
    lbContent.innerHTML = ""
    lbActions.innerHTML = ""

    const type = el.dataset.type ?? ""
    const href = el.dataset.href ?? ""
    const cta  = el.dataset.cta  ?? "Visit"

    if (type === "photo") {
      const img = document.createElement("img")
      img.src = el.dataset.src ?? el.querySelector("img")?.src ?? ""
      img.className = "lb-photo"
      img.draggable = false
      lbContent.appendChild(img)
    } else {
      // Expanded card
      const title = el.dataset.title ?? ""
      const sub   = el.dataset.sub   ?? ""

      const card = document.createElement("div")
      card.className = "lb-card"
      card.innerHTML = `
        <p class="lb-eye">${type}</p>
        <p class="lb-title">${title}</p>
        ${sub ? `<p class="lb-sub">${sub}</p>` : ""}
      `
      lbContent.appendChild(card)

      if (href) {
        const link = document.createElement("a")
        link.href = href
        link.textContent = `${cta} ↗`
        link.target = "_blank"
        link.rel = "noopener noreferrer"
        link.className = "lb-action"
        lbActions.appendChild(link)
      }
    }

    lightbox.classList.add("is-open")
    lightbox.setAttribute("aria-hidden", "false")
  }

  function closeLightbox() {
    lightbox.classList.remove("is-open")
    lightbox.setAttribute("aria-hidden", "true")
  }

  lbBackdrop.addEventListener("click", closeLightbox)
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeLightbox()
  })

  // Attach click to every float
  document.querySelectorAll<HTMLElement>(".float").forEach((el) => {
    el.addEventListener("click", () => openLightbox(el))
  })
</script>
