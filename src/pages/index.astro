</style>

<script>
  interface FloatState {
    el: HTMLElement
    ax1: number; wx1: number; px1: number
    ax2: number; wx2: number; px2: number
    ay1: number; wy1: number; py1: number
    ay2: number; wy2: number; py2: number
    ar:  number; wr:  number; pr:  number
    pullX: number; pullY: number
  }

  function rand(min: number, max: number) {
    return Math.random() * (max - min) + min
  }

  // ── Mouse ──────────────────────────────────────────────────────────
  let mouseX = -9999
  let mouseY = -9999
  document.addEventListener("mousemove", (e) => { mouseX = e.clientX; mouseY = e.clientY })

  // ── Scroll: smoothly freeze animation while scrolling ─────────────
  // Rather than toggling a boolean, we lerp a speed factor (0–1) that
  // scales how fast animT advances each frame. This gives a smooth
  // deceleration into the freeze and a smooth ease-back when done.
  // Critically, we never change bob VALUES — only the rate of time —
  // so there is no positional snap.
  let scrollSpeedFactor  = 1.0
  let targetScrollSpeed  = 1.0
  const SCROLL_LERP      = 0.09   // ~400 ms to reach ~95% of target at 60 fps
  let scrollTimer: ReturnType<typeof setTimeout> | null = null
  window.addEventListener("scroll", () => {
    targetScrollSpeed = 0.18
    if (scrollTimer) clearTimeout(scrollTimer)
    scrollTimer = setTimeout(() => { targetScrollSpeed = 1.0 }, 150)
  }, { passive: true })

  // ── Speed slider ────────────────────────────────────────────────────
  let speedMult = 1.0
  const speedRange   = document.getElementById("speed-range") as HTMLInputElement | null
  const speedNotches = document.querySelectorAll<HTMLElement>(".speed-notch")
  const DRAG_SNAP    = 15
  const RELEASE_SNAP = 18
  let inSnapZone     = true

  function triggerHaptic() { try { navigator.vibrate?.(6) } catch {} }

  function updateNotch() {
    const atCenter = Math.abs(Number(speedRange?.value ?? 100) - 100) <= DRAG_SNAP
    speedNotches.forEach(n => n.classList.toggle("at-center", atCenter))
  }

  function updateFill() {
    if (!speedRange) return
    const pct = (Number(speedRange.value) / 220 * 100).toFixed(2)
    speedRange.style.setProperty("--fill", `${pct}%`)
  }

  updateNotch()
  updateFill()

  speedRange?.addEventListener("input", () => {
    const val = Number(speedRange.value)
    if (Math.abs(val - 100) <= DRAG_SNAP) {
      speedRange.value = "100"
      speedMult = 1.0
      if (!inSnapZone) { inSnapZone = true; triggerHaptic() }
    } else {
      inSnapZone = false
      speedMult = val / 100
    }
    updateNotch()
    updateFill()
  })

  speedRange?.addEventListener("wheel", (e) => {
    e.preventDefault()
    const delta = e.deltaX !== 0 ? e.deltaX : -e.deltaY
    const newVal = Math.max(0, Math.min(220, Number(speedRange.value) + delta * 0.4))
    speedRange.value = String(Math.round(newVal))
    speedRange.dispatchEvent(new Event("input"))
  }, { passive: false })

  speedRange?.addEventListener("pointerup", () => {
    const val = Number(speedRange.value)
    if (Math.abs(val - 100) <= RELEASE_SNAP) {
      speedRange.value = "100"
      speedMult = 1.0
      if (!inSnapZone) triggerHaptic()
      inSnapZone = true
    }
    updateNotch()
    updateFill()
  })

  // ── Loading screen ───────────────────────────────────────────────────
  const loadingScreen = document.getElementById("loading-screen")
  window.addEventListener("load", () => {
    loadingScreen?.classList.add("done")
    setTimeout(() => loadingScreen?.remove(), 800)
  })

  // ── Float states ───────────────────────────────────────────────────
  const states: FloatState[] = []
  document.querySelectorAll<HTMLElement>(".float").forEach((el) => {
    states.push({
      el,
      ax1: rand(4, 9),    wx1: rand(0.20, 0.42), px1: rand(0, Math.PI * 2),
      ax2: rand(3, 6),    wx2: rand(0.45, 0.72), px2: rand(0, Math.PI * 2),
      ay1: rand(6, 13),   wy1: rand(0.22, 0.48), py1: rand(0, Math.PI * 2),
      ay2: rand(4, 8),    wy2: rand(0.50, 0.80), py2: rand(0, Math.PI * 2),
      ar:  rand(1.5, 3.5), wr: rand(0.18, 0.35), pr:  rand(0, Math.PI * 2),
      pullX: 0, pullY: 0,
    })
  })

  // ── Proximity pull constants ───────────────────────────────────────
  const PULL_RADIUS = 180
  const PULL_MAX    = 7
  const LERP        = 0.06

  // Accumulated animation time — only advances when not scrolling.
  // The speed slider scales how fast time accrues.
  let animT    = 0
  let lastTs: number | null = null

  function animate(ts: number) {
    if (lastTs === null) lastTs = ts
    const dtSec = (ts - lastTs) / 1000
    lastTs = ts

    scrollSpeedFactor += (targetScrollSpeed - scrollSpeedFactor) * SCROLL_LERP
    animT += dtSec * speedMult * scrollSpeedFactor

    for (const s of states) {
      const bobX = s.ax1 * Math.sin(s.wx1 * animT + s.px1) + s.ax2 * Math.sin(s.wx2 * animT + s.px2)
      const bobY = s.ay1 * Math.sin(s.wy1 * animT + s.py1) + s.ay2 * Math.sin(s.wy2 * animT + s.py2)
      const rot  = s.ar  * Math.sin(s.wr  * animT + s.pr)

      const rect = s.el.getBoundingClientRect()
      const elCX = rect.left + rect.width  / 2
      const elCY = rect.top  + rect.height / 2
      const dx   = mouseX - elCX
      const dy   = mouseY - elCY
      const dist = Math.sqrt(dx * dx + dy * dy) || 1
      const inf  = Math.max(0, 1 - dist / PULL_RADIUS)
      const tx   = (dx / dist) * inf * PULL_MAX
      const ty   = (dy / dist) * inf * PULL_MAX

      s.pullX += (tx - s.pullX) * LERP
      s.pullY += (ty - s.pullY) * LERP

      s.el.style.transform =
        `translate(${bobX + s.pullX}px, ${bobY + s.pullY}px) rotate(${rot}deg)`
    }

    // Drive section heading waves: paused CSS animation scrubbed by animT
    document.documentElement.style.setProperty("--wave-delay", `-${(animT * 14).toFixed(3)}s`)

    requestAnimationFrame(animate)
  }
  requestAnimationFrame(animate)

  // ── Lightbox ───────────────────────────────────────────────────────
  const lightbox   = document.getElementById("lightbox")!
  const lbContent  = document.getElementById("lb-content")!
  const lbActions  = document.getElementById("lb-actions")!
  const lbBackdrop = lightbox.querySelector(".lb-backdrop")!

  function esc(s: string) {
    return s.replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;")
  }

  function openLightbox(el: HTMLElement) {
    lbContent.innerHTML = ""
    lbActions.innerHTML = ""
    const {
      type = "", href = "", cta = "Visit",
      title = "", sub = "", preview = "",
      expanded = "", handle = "", desc = "", avatar = "",
    } = el.dataset

    if (type === "photo") {
      const img = document.createElement("img")
      img.src = el.dataset.src ?? el.querySelector("img")?.src ?? ""
      img.className = "lb-photo"
      img.draggable = false
      lbContent.appendChild(img)

    } else if (type === "social") {
      const card = document.createElement("div")
      card.className = "lb-card"

      const stravaRaw = el.dataset.strava
      if (stravaRaw) {
        // Strava card with live activity list
        try {
          const acts: Array<{id:number;name:string;sport_type:string;distance:number;moving_time:number;start_date:string;calories:number}> =
            JSON.parse(stravaRaw)
          const rows = acts.map(a => {
            const sport = a.sport_type.replace(/([a-z])([A-Z])/g, "$1 $2")
            const h = Math.floor(a.moving_time / 3600)
            const m = Math.floor((a.moving_time % 3600) / 60)
            const dur  = h > 0 ? `${h}h ${m}m` : `${m}m`
            const date = new Date(a.start_date).toLocaleDateString("en-GB", { day: "numeric", month: "short" })
            const stats = [
              ...(a.distance > 0 ? [`${(a.distance / 1000).toFixed(1)} km`] : []),
              dur,
              ...(a.calories > 0 ? [`${Math.round(a.calories)} kcal`] : []),
              date,
            ].join(" · ")
            return `<a class="lb-activity" href="https://www.strava.com/activities/${a.id}" target="_blank" rel="noopener noreferrer">
              <span class="lb-activity-sport">${esc(sport)}</span>
              <span class="lb-activity-stats">${esc(stats)}</span>
            </a>`
          }).join("")
          card.innerHTML = `
            <p class="lb-eye">Strava</p>
            <p class="lb-eye" style="margin-top:1.2rem">Most recent activities</p>
            <div class="lb-activities">${rows}</div>
          `
        } catch {
          card.innerHTML = `<p class="lb-eye">${esc(title)}</p><p class="lb-handle">${esc(handle)}</p>`
        }
      } else {
        card.innerHTML = `
          ${avatar ? `<img class="lb-social-avatar" src="${esc(avatar)}" alt="${esc(title)}" />` : ""}
          <p class="lb-eye">${esc(title)}</p>
          ${handle ? `<p class="lb-handle">${esc(handle)}</p>` : ""}
          ${desc   ? `<p class="lb-desc">${esc(desc)}</p>`     : ""}
        `
      }
      lbContent.appendChild(card)

    } else if (type === "cv") {
      const card = document.createElement("div")
      card.className = "lb-card"

      if (title === "Languages" && expanded) {
        const rows = expanded.split("|").map((line) => {
          const colonIdx = line.indexOf(": ")
          const level  = colonIdx >= 0 ? line.slice(0, colonIdx) : line
          const values = colonIdx >= 0 ? line.slice(colonIdx + 2) : ""
          return `<div class="lb-lang-row">
            <span class="lb-lang-level">${esc(level)}</span>
            <span class="lb-lang-values">${esc(values)}</span>
          </div>`
        }).join("")
        card.innerHTML = `
          <p class="lb-eye">Languages</p>
          <div class="lb-lang-table">${rows}</div>
        `
      } else {
        card.innerHTML = `
          <p class="lb-eye">CV</p>
          <p class="lb-title">${esc(title)}</p>
          <p class="lb-sub">${esc(sub)}</p>
          ${expanded ? `<p class="lb-expanded">${esc(expanded)}</p>` : ""}
        `
      }
      lbContent.appendChild(card)

    } else {
      // Note / generic
      const card = document.createElement("div")
      card.className = "lb-card"
      card.innerHTML = `
        <p class="lb-eye">${esc(type)}</p>
        <p class="lb-title">${esc(title)}</p>
        ${sub     ? `<p class="lb-sub">${esc(sub)}</p>`         : ""}
        ${preview ? `<p class="lb-preview">${esc(preview)}</p>` : ""}
      `
      lbContent.appendChild(card)
    }

    if (href && type !== "photo") {
      const a = document.createElement("a")
      a.href = href
      a.textContent = `${cta} ↗`
      a.target = "_blank"
      a.rel = "noopener noreferrer"
      a.className = "lb-action"
      lbActions.appendChild(a)
    }

    lightbox.classList.add("is-open")
    lightbox.setAttribute("aria-hidden", "false")
  }

  function closeLightbox() {
    lightbox.classList.remove("is-open")
    lightbox.setAttribute("aria-hidden", "true")
  }

  lbBackdrop.addEventListener("click", closeLightbox)
  document.addEventListener("keydown", (e) => { if (e.key === "Escape") closeLightbox() })
  document.querySelectorAll<HTMLElement>(".float").forEach((el) => {
    el.addEventListener("click", () => openLightbox(el))
  })
</script>
