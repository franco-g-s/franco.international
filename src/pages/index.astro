---
// Fetch recent garden notes at build time
interface GardenNote {
  title: string
  slug: string
  date: string | null
  description: string | null
}

let recentNotes: GardenNote[] = []
try {
  const res = await fetch("https://garden.franco.international/notes.json")
  if (res.ok) {
    const all: GardenNote[] = await res.json()
    recentNotes = all.slice(0, 3)
  }
} catch {
  // garden unavailable during build — sections renders without live notes
}

// Photos: add your files to public/photos/ named 01.jpg through 12.jpg
// Each entry: anchor position (css top/left as %), size (px), mobile visibility
const photos = [
  { id: "01", top: "6%",  left: "4%",  w: 210, h: 158, mobile: true  },
  { id: "02", top: "7%",  left: "24%", w: 152, h: 212, mobile: false },
  { id: "03", top: "3%",  left: "57%", w: 182, h: 138, mobile: true  },
  { id: "04", top: "8%",  left: "79%", w: 148, h: 202, mobile: false },
  { id: "05", top: "36%", left: "1%",  w: 172, h: 132, mobile: false },
  { id: "06", top: "57%", left: "2%",  w: 142, h: 192, mobile: false },
  { id: "07", top: "31%", left: "83%", w: 158, h: 122, mobile: false },
  { id: "08", top: "57%", left: "81%", w: 172, h: 132, mobile: false },
  { id: "09", top: "75%", left: "5%",  w: 182, h: 142, mobile: true  },
  { id: "10", top: "78%", left: "29%", w: 158, h: 118, mobile: false },
  { id: "11", top: "72%", left: "60%", w: 142, h: 192, mobile: false },
  { id: "12", top: "73%", left: "83%", w: 168, h: 128, mobile: true  },
]

const cvHighlights = [
  { label: "Based in", value: "Zürich, Switzerland" },
  { label: "Upcoming", value: "ETH Zürich — Mechanical Engineering (2027)" },
  { label: "Currently", value: "Autonomous Systems Lab, ETH Zürich — Zivildienst" },
  { label: "Languages", value: "English, Spanish, German, French, Italian, Mandarin" },
]

const elsewhere = [
  { label: "Instagram",  href: "https://www.instagram.com/franco_gomez_s/" },
  { label: "Strava",     href: "https://www.strava.com/athletes/franco" },
  { label: "YouTube",    href: "https://www.youtube.com/@franco" },
  { label: "LinkedIn",   href: "https://www.linkedin.com/in/franco-gómez-schumacher-17a985123/" },
  { label: "GitHub",     href: "https://github.com/franco-g-s" },
]
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Franco Gómez Schumacher — personal hub" />
    <title>Franco Gómez Schumacher</title>
    <link rel="preconnect" href="https://rsms.me/" />
    <link rel="stylesheet" href="https://rsms.me/inter/inter.css" />
  </head>

  <body>

    <!-- ── Landing ──────────────────────────────────────── -->
    <section class="landing" aria-label="Landing">

      <div class="photos" aria-hidden="true">
        {photos.map((p) => (
          <div
            class:list={["photo", { "photo--mobile-hidden": !p.mobile }]}
            style={`top:${p.top};left:${p.left};width:${p.w}px;height:${p.h}px`}
            data-photo-id={p.id}
          >
            <img
              src={`/photos/${p.id}.jpg`}
              alt=""
              width={p.w}
              height={p.h}
              loading="eager"
              draggable="false"
            />
          </div>
        ))}
      </div>

      <h1 class="name">
        <span class="name-line">Franco Gómez</span>
        <span class="name-line">Schumacher</span>
      </h1>

    </section>

    <!-- ── Scroll sections ──────────────────────────────── -->
    <main>

      <!-- Garden -->
      <section class="section" id="garden">
        <p class="section-label">Garden</p>
        {recentNotes.length > 0 ? (
          <ul class="note-list">
            {recentNotes.map((note) => (
              <li>
                <a href={`https://garden.franco.international/${note.slug}`} class="note-link">
                  <span class="note-title">{note.title}</span>
                  {note.date && (
                    <span class="note-date">
                      {new Date(note.date).toLocaleDateString("en-GB", {
                        day: "numeric",
                        month: "short",
                        year: "numeric",
                      })}
                    </span>
                  )}
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="section-body">A growing collection of notes on engineering, science, and life.</p>
        )}
        <a href="https://garden.franco.international" class="section-link">
          Visit the garden ↗
        </a>
      </section>

      <!-- CV -->
      <section class="section" id="cv">
        <p class="section-label">CV</p>
        <dl class="cv-highlights">
          {cvHighlights.map((h) => (
            <div class="cv-row">
              <dt>{h.label}</dt>
              <dd>{h.value}</dd>
            </div>
          ))}
        </dl>
        <a href="https://cv.franco.international" class="section-link">
          Full CV ↗
        </a>
      </section>

      <!-- Elsewhere -->
      <section class="section section--last" id="elsewhere">
        <p class="section-label">Elsewhere</p>
        <ul class="elsewhere-list">
          {elsewhere.map((e) => (
            <li>
              <a href={e.href} target="_blank" rel="noopener noreferrer" class="elsewhere-link">
                {e.label} ↗
              </a>
            </li>
          ))}
        </ul>
      </section>

    </main>

  </body>
</html>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --text:        #1a1a1a;
    --muted:       #9a9a9a;
    --border:      #e8e8e8;
    --accent:      #1a1a1a;
    --bg:          #ffffff;
  }

  html {
    font-family: "Inter", -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
    font-feature-settings: "cv05", "ss01";
    background: var(--bg);
    color: var(--text);
    -webkit-font-smoothing: antialiased;
  }

  body { overflow-x: hidden; }

  /* ── Landing ─────────────────────────────────────── */
  .landing {
    position: relative;
    width: 100vw;
    height: 100vh;
    overflow: hidden;
    background: var(--bg);
  }

  /* ── Name ────────────────────────────────────────── */
  .name {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 10;
    text-align: center;
    font-size: clamp(2.4rem, 5.5vw, 5rem);
    font-weight: 200;
    letter-spacing: -0.03em;
    line-height: 1.05;
    color: var(--text);
    white-space: nowrap;
    pointer-events: none;
    user-select: none;
  }

  .name-line { display: block; }

  /* ── Photos ──────────────────────────────────────── */
  .photos { position: absolute; inset: 0; }

  .photo {
    position: absolute;
    will-change: transform;
    cursor: default;
  }

  .photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 3px;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.10), 0 1px 3px rgba(0, 0, 0, 0.06);
    pointer-events: none;
    user-select: none;
    /* placeholder tint until photos load */
    background: #f0f0f0;
  }

  /* ── Scroll sections ─────────────────────────────── */
  main {
    position: relative;
    z-index: 20;
  }

  .section {
    max-width: 560px;
    margin: 0 auto;
    padding: 7rem 2rem;
    border-top: 1px solid var(--border);
  }

  .section--last { padding-bottom: 10rem; }

  .section-label {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 2rem;
  }

  .section-body {
    font-size: 1rem;
    color: var(--muted);
    line-height: 1.65;
    margin-bottom: 2.5rem;
  }

  .section-link {
    display: inline-block;
    font-size: 0.9rem;
    font-weight: 400;
    color: var(--text);
    text-decoration: none;
    letter-spacing: 0.01em;
    margin-top: 2rem;
    border-bottom: 1px solid var(--border);
    padding-bottom: 1px;
    transition: border-color 0.2s;
  }

  .section-link:hover { border-color: var(--text); }

  /* Garden note list */
  .note-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .note-link {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1.5rem;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--border);
    text-decoration: none;
    color: var(--text);
    transition: color 0.15s;
  }

  .note-list li:first-child .note-link { border-top: 1px solid var(--border); }

  .note-link:hover { color: var(--muted); }

  .note-title {
    font-size: 0.95rem;
    font-weight: 400;
  }

  .note-date {
    font-size: 0.8rem;
    color: var(--muted);
    white-space: nowrap;
    flex-shrink: 0;
  }

  /* CV highlights */
  .cv-highlights {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .cv-row {
    display: flex;
    gap: 2rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--border);
    font-size: 0.9rem;
    align-items: baseline;
  }

  .cv-highlights .cv-row:first-child { border-top: 1px solid var(--border); }

  .cv-row dt {
    font-weight: 400;
    color: var(--muted);
    min-width: 6rem;
    flex-shrink: 0;
    font-size: 0.82rem;
  }

  .cv-row dd {
    color: var(--text);
    line-height: 1.5;
  }

  /* Elsewhere */
  .elsewhere-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .elsewhere-link {
    display: block;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--border);
    font-size: 0.95rem;
    font-weight: 400;
    color: var(--text);
    text-decoration: none;
    transition: color 0.15s;
  }

  .elsewhere-list li:first-child .elsewhere-link { border-top: 1px solid var(--border); }

  .elsewhere-link:hover { color: var(--muted); }

  /* ── Mobile ──────────────────────────────────────── */
  @media (max-width: 768px) {
    .photo--mobile-hidden { display: none; }

    /* reposition the 4 surviving photos to corners */
    .photo[data-photo-id="01"] { top: 4% !important; left: 2% !important; width: 110px !important; height: 85px !important; }
    .photo[data-photo-id="03"] { top: 4% !important; left: auto !important; right: 2%; width: 105px !important; height: 80px !important; }
    .photo[data-photo-id="09"] { top: auto !important; bottom: 4%; left: 2% !important; width: 110px !important; height: 85px !important; }
    .photo[data-photo-id="12"] { top: auto !important; bottom: 4%; left: auto !important; right: 2%; width: 105px !important; height: 80px !important; }

    .name { font-size: clamp(2rem, 9vw, 3rem); }

    .section { padding: 5rem 1.5rem; }

    .cv-row { flex-direction: column; gap: 0.2rem; }
    .cv-row dt { min-width: unset; }
  }
</style>

<script>
  // ── Harbor-bobbing animation ──────────────────────────────────
  // Each photo oscillates around its anchor with layered sine waves,
  // simulating the motion of a boat floating on water.

  interface PhotoState {
    el: HTMLElement
    // X: two overlapping sine components
    ax1: number; wx1: number; px1: number
    ax2: number; wx2: number; px2: number
    // Y: two overlapping sine components (more amplitude — vertical bob)
    ay1: number; wy1: number; py1: number
    ay2: number; wy2: number; py2: number
    // Rotation
    ar: number; wr: number; pr: number
  }

  function rand(min: number, max: number) {
    return Math.random() * (max - min) + min
  }

  const photoEls = document.querySelectorAll<HTMLElement>(".photo")
  const states: PhotoState[] = []

  photoEls.forEach((el) => {
    states.push({
      el,
      ax1: rand(3, 7),   wx1: rand(0.20, 0.42), px1: rand(0, Math.PI * 2),
      ax2: rand(2, 5),   wx2: rand(0.45, 0.72), px2: rand(0, Math.PI * 2),
      ay1: rand(5, 11),  wy1: rand(0.22, 0.48), py1: rand(0, Math.PI * 2),
      ay2: rand(3, 7),   wy2: rand(0.50, 0.80), py2: rand(0, Math.PI * 2),
      ar:  rand(1.2, 2.8), wr: rand(0.18, 0.35), pr: rand(0, Math.PI * 2),
    })
  })

  let startTime: number | null = null

  function animate(timestamp: number) {
    if (startTime === null) startTime = timestamp
    const t = (timestamp - startTime) / 1000

    for (const s of states) {
      const x = s.ax1 * Math.sin(s.wx1 * t + s.px1)
              + s.ax2 * Math.sin(s.wx2 * t + s.px2)
      const y = s.ay1 * Math.sin(s.wy1 * t + s.py1)
              + s.ay2 * Math.sin(s.wy2 * t + s.py2)
      const r = s.ar  * Math.sin(s.wr  * t + s.pr)
      s.el.style.transform = `translate(${x}px, ${y}px) rotate(${r}deg)`
    }

    requestAnimationFrame(animate)
  }

  requestAnimationFrame(animate)
</script>
