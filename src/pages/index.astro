---
interface GardenNote {
  title: string
  slug: string
  date: string | null
  description: string | null
}

let recentNotes: GardenNote[] = []
try {
  const res = await fetch("https://garden.franco.international/notes.json")
  if (res.ok) {
    const all: GardenNote[] = await res.json()
    recentNotes = all.slice(0, 5)
  }
} catch { /* garden unavailable at build time */ }

function fmtDate(iso: string | null) {
  if (!iso) return ""
  return new Date(iso).toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" })
}

function truncate(str: string | null, n: number) {
  if (!str) return ""
  return str.length > n ? str.slice(0, n).trimEnd() + "…" : str
}

// ── Photos: 18 spread across full 500vh canvas ───────────────────────────────
const photos = [
  // Landing zone (0–100vh)
  { id: "01", top: "5vh",   left: "4%",  w: 210, h: 158 },
  { id: "02", top: "12vh",  left: "24%", w: 152, h: 212 },
  { id: "03", top: "3vh",   left: "57%", w: 182, h: 138 },
  { id: "04", top: "8vh",   left: "79%", w: 148, h: 202 },
  // Transition 1→2 (80–140vh)
  { id: "05", top: "82vh",  left: "2%",  w: 172, h: 132 },
  { id: "06", top: "90vh",  left: "80%", w: 142, h: 192 },
  { id: "07", top: "110vh", left: "42%", w: 165, h: 125 },
  // Garden zone fill (140–220vh)
  { id: "08", top: "148vh", left: "43%", w: 138, h: 188 },
  { id: "09", top: "192vh", left: "50%", w: 158, h: 120 },
  // Transition 2→3 (210–265vh)
  { id: "10", top: "218vh", left: "6%",  w: 158, h: 122 },
  { id: "11", top: "235vh", left: "79%", w: 175, h: 135 },
  // CV zone fill (265–335vh)
  { id: "12", top: "272vh", left: "44%", w: 145, h: 110 },
  { id: "13", top: "318vh", left: "48%", w: 162, h: 122 },
  // Transition 3→4 (330–385vh)
  { id: "14", top: "338vh", left: "3%",  w: 182, h: 142 },
  { id: "15", top: "358vh", left: "77%", w: 158, h: 118 },
  // Elsewhere zone fill (385–465vh)
  { id: "16", top: "392vh", left: "44%", w: 148, h: 112 },
  { id: "17", top: "462vh", left: "8%",  w: 142, h: 192 },
  { id: "18", top: "478vh", left: "74%", w: 168, h: 128 },
]

// ── Card positions ────────────────────────────────────────────────────────────
// Garden zone anchor at 165vh — 5 notes, spread wider
const notePos = [
  "top:135vh;left:6%",
  "top:152vh;left:63%",
  "top:172vh;left:22%",
  "top:162vh;left:76%",
  "top:188vh;left:40%",
]
// CV zone anchor at 295vh
const cvPos = [
  "top:272vh;left:5%",
  "top:285vh;left:65%",
  "top:306vh;left:16%",
  "top:297vh;left:74%",
]
// Elsewhere zone anchor at 425vh
const socialPos = [
  "top:402vh;left:7%",
  "top:415vh;left:26%",
  "top:428vh;left:57%",
  "top:420vh;left:75%",
  "top:440vh;left:40%",
]

const cvHighlights = [
  { label: "Based in",  value: "Zürich, Switzerland" },
  { label: "Upcoming",  value: "ETH Zürich — Mechanical Engineering (2027)" },
  { label: "Currently", value: "Autonomous Systems Lab, ETH Zürich — Zivildienst" },
  { label: "Languages", value: "English, Spanish, German, French, Italian, Mandarin" },
]

const elsewhere = [
  { label: "Instagram", href: "https://www.instagram.com/francogs.mp4/" },
  { label: "YouTube",   href: "https://www.youtube.com/@francogs.mp4/" },
  // TODO: replace with your Strava athlete profile URL
  { label: "Strava",    href: "https://www.strava.com/athletes/" },
  { label: "LinkedIn",  href: "https://www.linkedin.com/in/franco-g%C3%B3mez-schumacher-17a985123/" },
  { label: "GitHub",    href: "https://github.com/franco-g-s" },
]
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Franco Gómez Schumacher" />
  <title>Franco Gómez Schumacher</title>
  <link rel="preconnect" href="https://rsms.me/" />
  <link rel="stylesheet" href="https://rsms.me/inter/inter.css" />
</head>

<body>
<div class="canvas">

  <!-- ── Anchored headings (no animation) ────────────────────────── -->
  <h1 class="anchor name">
    <span>Franco Gómez</span>
    <span>Schumacher</span>
  </h1>
  <p class="anchor zone-label" style="top:162vh;left:50%">Garden</p>
  <p class="anchor zone-label" style="top:292vh;left:50%">CV</p>
  <p class="anchor zone-label" style="top:422vh;left:50%">Elsewhere</p>

  <!-- ── Photos ──────────────────────────────────────────────────── -->
  {photos.map((p) => (
    <div
      class="float"
      data-type="photo"
      data-src={`/photos/${p.id}.jpg`}
      style={`top:${p.top};left:${p.left};width:${p.w}px;height:${p.h}px`}
    >
      <div class="float-inner">
        <img src={`/photos/${p.id}.jpg`} alt="" width={p.w} height={p.h}
             loading="eager" draggable="false" />
      </div>
    </div>
  ))}

  <!-- ── Garden note cards ───────────────────────────────────────── -->
  {recentNotes.map((note, i) => (
    <div
      class="float card card--note"
      data-type="note"
      data-title={note.title}
      data-sub={fmtDate(note.date)}
      data-preview={truncate(note.description, 120)}
      data-href={`https://garden.franco.international/${note.slug}`}
      data-cta="Read note"
      style={notePos[i]}
    >
      <div class="float-inner">
        <p class="card-eye">Note · {fmtDate(note.date)}</p>
        <p class="card-title">{note.title}</p>
        {note.description && (
          <p class="card-preview">{truncate(note.description, 90)}</p>
        )}
      </div>
    </div>
  ))}

  <!-- Fallback if garden feed unavailable -->
  {recentNotes.length === 0 && (
    <div class="float card" data-type="link" data-href="https://garden.franco.international"
         data-cta="Visit" data-depth="0.007" style={notePos[0]}>
      <div class="float-inner">
        <p class="card-eye">Garden</p>
        <p class="card-title">A growing collection of notes</p>
      </div>
    </div>
  )}

  <!-- ── CV highlight cards ──────────────────────────────────────── -->
  {cvHighlights.map((h, i) => (
    <div
      class="float card card--cv"
      data-type="cv"
      data-title={h.label}
      data-sub={h.value}
      data-href="https://cv.franco.international"
      data-cta="View CV"
      style={cvPos[i]}
    >
      <div class="float-inner">
        <p class="card-eye">{h.label}</p>
        <p class="card-value">{h.value}</p>
      </div>
    </div>
  ))}

  <!-- ── Social cards ────────────────────────────────────────────── -->
  {elsewhere.map((e, i) => (
    <div
      class="float card card--social"
      data-type="social"
      data-title={e.label}
      data-href={e.href}
      data-cta={`Open ${e.label}`}
      style={socialPos[i]}
    >
      <div class="float-inner">
        <p class="card-social">{e.label} ↗</p>
      </div>
    </div>
  ))}

</div>

<!-- ── Lightbox ───────────────────────────────────────────────────── -->
<div id="lightbox" class="lightbox" aria-hidden="true">
  <div class="lb-backdrop"></div>
  <div class="lb-body">
    <div id="lb-content"></div>
    <div id="lb-actions"></div>
  </div>
</div>

</body>
</html>

<style is:global>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
  --text:   #1a1a1a;
  --muted:  #9a9a9a;
  --border: #e4e4e4;
  --bg:     #ffffff;
  --shadow: 0 2px 14px rgba(0,0,0,0.09), 0 1px 3px rgba(0,0,0,0.05);
  --shadow-hover: 0 8px 32px rgba(0,0,0,0.13), 0 2px 6px rgba(0,0,0,0.06);
}

html {
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
  font-feature-settings: "cv05", "ss01";
  background: var(--bg);
  color: var(--text);
  -webkit-font-smoothing: antialiased;
}

body { overflow-x: hidden; }

/* ── Canvas ───────────────────────────────────────────────────────── */
.canvas {
  position: relative;
  min-height: 500vh;
  background: var(--bg);
  overflow: hidden;
}

/* ── Anchors ──────────────────────────────────────────────────────── */
.anchor {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  text-align: center;
  pointer-events: none;
  user-select: none;
  white-space: nowrap;
  z-index: 10;
}

.name {
  top: 50vh;
  transform: translate(-50%, -50%);
  font-size: clamp(2.4rem, 5.5vw, 5rem);
  font-weight: 200;
  letter-spacing: -0.03em;
  line-height: 1.05;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.zone-label {
  transform: translate(-50%, -50%);
  font-size: clamp(1.5rem, 2.5vw, 2.2rem);
  font-weight: 200;
  letter-spacing: -0.025em;
  color: var(--text);
}

/* ── Floats ───────────────────────────────────────────────────────── */
.float {
  position: absolute;
  will-change: transform;
  cursor: pointer;
  z-index: 5;
}

.float-inner {
  width: 100%;
  height: 100%;
  transition: transform 0.28s cubic-bezier(0.34, 1.4, 0.64, 1),
              box-shadow 0.28s ease;
  border-radius: 3px;
}

.float:hover .float-inner { transform: scale(1.04); }

/* Photos */
.float img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  border-radius: 3px;
  box-shadow: var(--shadow);
  pointer-events: none;
  user-select: none;
  background: #ebebeb;
  transition: box-shadow 0.28s ease;
}

.float:hover img { box-shadow: var(--shadow-hover); }

/* Cards */
.card {
  width: max-content;
  height: auto !important;
}

.card .float-inner {
  background: var(--bg);
  border: 1px solid var(--border);
  border-radius: 4px;
  box-shadow: var(--shadow);
}

.card:hover .float-inner { box-shadow: var(--shadow-hover); }

.card-eye {
  font-size: 0.62rem;
  font-weight: 500;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--muted);
  margin-bottom: 0.4rem;
}

/* Note cards — larger, with preview */
.card--note { max-width: 300px; min-width: 220px; }
.card--note .float-inner { padding: 1.1rem 1.3rem; }

.card-title {
  font-size: 0.95rem;
  font-weight: 400;
  color: var(--text);
  line-height: 1.45;
  max-width: 26ch;
  margin-bottom: 0.4rem;
}

.card-preview {
  font-size: 0.78rem;
  color: var(--muted);
  line-height: 1.55;
  max-width: 30ch;
}

/* CV cards */
.card--cv { max-width: 270px; min-width: 190px; }
.card--cv .float-inner { padding: 0.9rem 1.1rem; }

.card-sub {
  font-size: 0.75rem;
  color: var(--muted);
  margin-top: 0.2rem;
}

.card-value {
  font-size: 0.88rem;
  font-weight: 400;
  color: var(--text);
  line-height: 1.45;
  max-width: 26ch;
}

/* Social cards */
.card--social { min-width: 130px; max-width: 190px; }
.card--social .float-inner { padding: 0.8rem 1.1rem; }

.card-social {
  font-size: 0.95rem;
  font-weight: 400;
  color: var(--text);
}

/* ── Lightbox ─────────────────────────────────────────────────────── */
.lightbox {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.22s ease;
}

.lightbox.is-open {
  opacity: 1;
  pointer-events: all;
}

.lb-backdrop {
  position: absolute;
  inset: 0;
  background: rgba(255, 255, 255, 0.80);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
}

.lb-body {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1.5rem;
  max-width: 88vw;
  max-height: 88vh;
}

/* Lightbox: photo */
.lb-photo {
  display: block;
  max-width: 85vw;
  max-height: 80vh;
  object-fit: contain;
  border-radius: 4px;
  box-shadow: 0 16px 60px rgba(0,0,0,0.18), 0 4px 12px rgba(0,0,0,0.10);
}

/* Lightbox: card expand */
.lb-card {
  background: var(--bg);
  border: 1px solid var(--border);
  border-radius: 6px;
  padding: 2rem 2.5rem;
  min-width: 260px;
  max-width: 460px;
  box-shadow: 0 16px 60px rgba(0,0,0,0.12), 0 4px 12px rgba(0,0,0,0.06);
  text-align: center;
}

.lb-eye {
  font-size: 0.68rem;
  font-weight: 500;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--muted);
  margin-bottom: 0.6rem;
}

.lb-title {
  font-size: 1.15rem;
  font-weight: 300;
  letter-spacing: -0.02em;
  line-height: 1.4;
  margin-bottom: 0.4rem;
}

.lb-sub {
  font-size: 0.85rem;
  color: var(--muted);
}

.lb-action {
  display: inline-block;
  font-size: 0.88rem;
  font-weight: 400;
  color: var(--text);
  text-decoration: none;
  border-bottom: 1px solid var(--border);
  padding-bottom: 2px;
  transition: border-color 0.15s;
}

.lb-action:hover { border-color: var(--text); }

/* ── Mobile ───────────────────────────────────────────────────────── */
@media (max-width: 768px) {
  .canvas { min-height: 420vh; }

  .name { font-size: clamp(2rem, 9vw, 3rem); }

  .zone-label { font-size: clamp(1.2rem, 5vw, 1.6rem); }

  /* Reduce photo count visually — hide mid-canvas photos */
  .float[data-photo-id="05"],
  .float[data-photo-id="06"],
  .float[data-photo-id="07"],
  .float[data-photo-id="08"] { display: none; }

  .card { max-width: 180px; }
}
</style>

<script>
  interface FloatState {
    el: HTMLElement
    ax1: number; wx1: number; px1: number
    ax2: number; wx2: number; px2: number
    ay1: number; wy1: number; py1: number
    ay2: number; wy2: number; py2: number
    ar:  number; wr:  number; pr:  number
    pullX: number; pullY: number
  }

  function rand(min: number, max: number) {
    return Math.random() * (max - min) + min
  }

  // ── Mouse ──────────────────────────────────────────────────────────
  let mouseX = -9999
  let mouseY = -9999
  document.addEventListener("mousemove", (e) => { mouseX = e.clientX; mouseY = e.clientY })

  // ── Float states ───────────────────────────────────────────────────
  const states: FloatState[] = []
  document.querySelectorAll<HTMLElement>(".float").forEach((el) => {
    states.push({
      el,
      ax1: rand(3, 7),     wx1: rand(0.20, 0.42), px1: rand(0, Math.PI * 2),
      ax2: rand(2, 5),     wx2: rand(0.45, 0.72), px2: rand(0, Math.PI * 2),
      ay1: rand(5, 11),    wy1: rand(0.22, 0.48), py1: rand(0, Math.PI * 2),
      ay2: rand(3, 7),     wy2: rand(0.50, 0.80), py2: rand(0, Math.PI * 2),
      ar:  rand(1.2, 2.8), wr:  rand(0.18, 0.35), pr:  rand(0, Math.PI * 2),
      pullX: 0, pullY: 0,
    })
  })

  // ── Animation ──────────────────────────────────────────────────────
  // Proximity pull: each element is gently attracted toward the cursor
  // when within PULL_RADIUS px. Lerped for smooth motion.
  const PULL_RADIUS = 180
  const PULL_MAX    = 7
  const LERP        = 0.06

  let t0: number | null = null

  function animate(ts: number) {
    if (t0 === null) t0 = ts
    const t = (ts - t0) / 1000

    for (const s of states) {
      const bobX = s.ax1 * Math.sin(s.wx1 * t + s.px1) + s.ax2 * Math.sin(s.wx2 * t + s.px2)
      const bobY = s.ay1 * Math.sin(s.wy1 * t + s.py1) + s.ay2 * Math.sin(s.wy2 * t + s.py2)
      const rot  = s.ar  * Math.sin(s.wr  * t + s.pr)

      const rect = s.el.getBoundingClientRect()
      const elCX = rect.left + rect.width  / 2
      const elCY = rect.top  + rect.height / 2
      const dx   = mouseX - elCX
      const dy   = mouseY - elCY
      const dist = Math.sqrt(dx * dx + dy * dy) || 1
      const inf  = Math.max(0, 1 - dist / PULL_RADIUS)
      const tx   = (dx / dist) * inf * PULL_MAX
      const ty   = (dy / dist) * inf * PULL_MAX

      s.pullX += (tx - s.pullX) * LERP
      s.pullY += (ty - s.pullY) * LERP

      s.el.style.transform =
        `translate(${bobX + s.pullX}px, ${bobY + s.pullY}px) rotate(${rot}deg)`
    }
    requestAnimationFrame(animate)
  }
  requestAnimationFrame(animate)

  // ── Lightbox ───────────────────────────────────────────────────────
  const lightbox   = document.getElementById("lightbox")!
  const lbContent  = document.getElementById("lb-content")!
  const lbActions  = document.getElementById("lb-actions")!
  const lbBackdrop = lightbox.querySelector(".lb-backdrop")!

  function openLightbox(el: HTMLElement) {
    lbContent.innerHTML = ""
    lbActions.innerHTML = ""
    const { type = "", href = "", cta = "Visit",
            title = "", sub = "", preview = "" } = el.dataset

    if (type === "photo") {
      const img = document.createElement("img")
      img.src = el.dataset.src ?? el.querySelector("img")?.src ?? ""
      img.className = "lb-photo"
      img.draggable = false
      lbContent.appendChild(img)
    } else {
      const card = document.createElement("div")
      card.className = "lb-card"
      card.innerHTML = `
        <p class="lb-eye">${type}</p>
        <p class="lb-title">${title}</p>
        ${sub     ? `<p class="lb-sub">${sub}</p>`         : ""}
        ${preview ? `<p class="lb-preview">${preview}</p>` : ""}
      `
      lbContent.appendChild(card)
      if (href) {
        const a = document.createElement("a")
        a.href = href; a.textContent = `${cta} ↗`
        a.target = "_blank"; a.rel = "noopener noreferrer"
        a.className = "lb-action"
        lbActions.appendChild(a)
      }
    }
    lightbox.classList.add("is-open")
    lightbox.setAttribute("aria-hidden", "false")
  }

  function closeLightbox() {
    lightbox.classList.remove("is-open")
    lightbox.setAttribute("aria-hidden", "true")
  }

  lbBackdrop.addEventListener("click", closeLightbox)
  document.addEventListener("keydown", (e) => { if (e.key === "Escape") closeLightbox() })
  document.querySelectorAll<HTMLElement>(".float").forEach((el) => {
    el.addEventListener("click", () => openLightbox(el))
  })
</script>
